#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")"
podman run --rm --userns=keep-id \
  -e DOTNET_CLI_HOME=/tmp -e NUGET_PACKAGES=/tmp/nuget \
  -v "$PWD:/src/FxProGoldMomentum/project:Z" -w /src/FxProGoldMomentum/project \
  mcr.microsoft.com/dotnet/sdk@sha256:1b955f179b02df4f0eb5fadedaa898cbe44d620a64aab52eec72c8e91d1355b5 dotnet build FxProGoldMomentum.csproj -c Release
